# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev

# Database (PostgreSQL for production/Docker; SQLite fallback in dev)
DATABASE_URL=postgres://stockadvice:stockadvice@db:5432/stockadvice

# Redis / task queue
REDIS_URL=redis://redis:6379/0

# Tenant defaults
DEFAULT_TENANT_SLUG=default

